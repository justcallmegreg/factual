              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Projects with their record counts",
        "tags": [
          "api"
        ]
      }
    },
    "/api/v1/records": {
      "get": {
        "operationId": "records_api_v1_records_get",
        "parameters": [
          {
            "in": "query",
            "name": "project",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
