  "info": {
    "description": "Factual turns what you send to one Telegram chat into tamper-evident evidence and finds it again when you ask. Its bot, Thoth, records every message in an append-only, hash-chained ledger that is sealed and timestamped every 5 minutes. The `/api/v1` routes are read-only and need the bearer token from `API_TOKEN`.",
    "title": "Factual",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/projects": {
      "get": {
