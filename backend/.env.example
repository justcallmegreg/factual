# Factual backend configuration. Copy this file to .env and fill in the values.
# .env is never committed. Every variable from SPECIFICATION.md is listed here.

# Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Telegram. The token comes from @BotFather. Leave the chat ID empty at first:
# Thoth then records nothing and replies in the group with the group's ID.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-botfather
TELEGRAM_CAPTURE_CHAT_ID=

# PostgreSQL (the Compose stack uses these values)
DATABASE_URL=postgresql://factual:factual@postgres:5432/factual

# S3-compatible object storage for attachments (the Compose stack uses these values)
S3_ENDPOINT=http://s3:9000
S3_BUCKET=factual
S3_ACCESS_KEY_ID=factual
S3_SECRET_ACCESS_KEY=factual-dev-secret
# Retention in days for attachments; 0 switches Object Lock off
S3_OBJECT_LOCK_DAYS=3650

# Claude API
ANTHROPIC_API_KEY=sk-ant-replace-me
CLAUDE_MODEL=claude-sonnet-5-5
ASK_DAILY_LIMIT=200

# Keys: mounted files, never built into the image
SIGNING_KEY_FILE=/run/secrets/signing-key.pem
MASTER_KEY_FILE=/run/secrets/master.key

# Two RFC 3161 time-stamping authorities, separated by a comma
TSA_URLS=https://freetsa.org/tsr,http://timestamp.digicert.com
# Optional qualified TSA, used for one seal a day
QUALIFIED_TSA_URL=

# Sealing and time
SEAL_INTERVAL_SECONDS=300
TIMEZONE=Europe/Amsterdam
DAILY_HELP_TIME=06:00

# The reaction Thoth sets on every recorded message
ACK_REACTION=✍

# Bearer token for the read-only /api/v1 routes; empty switches them off
API_TOKEN=
